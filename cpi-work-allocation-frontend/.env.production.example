# Production frontend env — copy to `.env.production` on the EC2 host before
# running `npm run build`. Vite inlines these at build time.
#
#   cp .env.production.example .env.production
#   nano .env.production
#
# VITE_USE_API=true switches the data layer from localStorage to the live API.
# VITE_API_BASE_URL must point to the same HTTPS origin that Nginx serves the
# SPA from, with the /api path appended (Nginx reverse-proxies /api/* → :4000).

VITE_USE_API=true
VITE_API_BASE_URL=https://app.yourdomain.com/api
