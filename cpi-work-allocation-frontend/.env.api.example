# Copy this file to .env.local to enable API mode (live backend)
# .env.local overrides .env and is gitignored by Vite by default.
#
# API mode changes:
#   - Auth:    email-only OTP via POST /api/auth/request-otp  (no password)
#   - Data:    all reads/writes go to Express/Prisma instead of localStorage
#   - Migrate: run POST /api/migrate once to seed the DB from your localStorage export
VITE_USE_API=true
VITE_API_URL=http://localhost:4000
