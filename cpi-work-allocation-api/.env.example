DATABASE_URL="postgresql://cpi:YOUR_PASSWORD@127.0.0.1:5432/cpi_work_allocation?schema=public"
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:8080
JWT_SECRET=replace_me_with_a_long_random_string

# SMTP (leave blank in dev — OTP codes are logged to console instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CPI Work Allocation" <noreply@cpi.com.ph>

# Fallback recipient for workflow notifications when the assigned
# manager's email is empty (e.g. submitter is top-of-chain).
# Comma-separated for multiple recipients.
NOTIFICATION_FALLBACK_EMAIL=
