# ─────────────────────────────────────────────────────────────────────────────
# Production .env template — copy to `.env` on the EC2 host and fill in the
# placeholders. Never commit the real file.
#
#   cp .env.production.example .env
#   nano .env
#   chmod 600 .env
# ─────────────────────────────────────────────────────────────────────────────

# Postgres runs inside the docker-compose.prod.yml container on the same host,
# bound to 127.0.0.1:5433. The password here MUST match POSTGRES_PASSWORD in
# the compose .env (cpi-work-allocation-api/.env-postgres, see below).
DATABASE_URL="postgresql://cpi:REPLACE_WITH_POSTGRES_PASSWORD@127.0.0.1:5433/cpi_work_allocation?schema=public"

PORT=4000
NODE_ENV=production

# Public origin of the SPA — must match what users type in the browser.
# CORS_ORIGIN gates which origins can call /api; APP_URL is the base URL used
# in email links (OTP, welcome, password reset).
CORS_ORIGIN=https://app.yourdomain.com
APP_URL=https://app.yourdomain.com

# Secrets — regenerate, do not reuse dev values.
#   openssl rand -hex 48   for JWT_SECRET
#   openssl rand -hex 24   for MIGRATE_SECRET
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_48
MIGRATE_SECRET=REPLACE_WITH_openssl_rand_hex_24

# Outlook / Office 365 SMTP — same creds as local dev.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@cpi.com.ph
SMTP_PASS=REPLACE_WITH_OUTLOOK_APP_PASSWORD
SMTP_FROM="CPI Work Allocation <no-reply@cpi.com.ph>"

# Fallback recipient when a submitter has no manager email on record.
NOTIFICATION_FALLBACK_EMAIL=jnmrkmatibag@gmail.com
