generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  Employee
  Manager
  Finance
  Admin
}

enum AllocationStatus {
  Draft
  PendingReview
  Approved
  NeedsRevision
}

enum NotificationType {
  info
  success
  warning
  error
}

// ── Core domain models ───────────────────────────────────────────────────────

model User {
  // Human-readable prefixed ids preserved from localStorage: EMP001, MGR001,
  // FIN001, ADM001. (Legacy HEAD### ids from the retired "Head" role may
  // still exist as data; they are valid ids, just no longer minted.) New
  // records get the same prefix logic — the prefix is derived from the
  // user's highest-privilege role (see primaryRole() in cpi-work-allocation-shared).
  id           String   @id
  firstName    String
  lastName     String
  email        String   @unique
  // bcrypt hash of the user's account password. Nullable because admin-created
  // accounts are issued a one-time `passwordSetupToken` and have no hash until
  // the user completes the setup flow (POST /api/auth/setup-password). Login
  // (POST /api/auth/login) treats a null hash as "account not set up" and
  // refuses sign-in until the setup flow runs.
  passwordHash String?
  // One-time secure token mailed to the user when an admin creates their
  // account. The token is the URL-safe base64 of 32 random bytes; lookups
  // are constant-time on the unique index. Cleared (set to null) the
  // moment the user redeems it.
  passwordSetupToken     String?   @unique
  // Expiry stamp for `passwordSetupToken`. Tokens past this point are
  // rejected at /api/auth/setup-password. 24-hour TTL by default — long
  // enough to survive a delayed inbox, short enough that an unredeemed
  // link from a months-old admin action can't be exploited.
  passwordSetupExpiresAt DateTime?
  // One-time secure token mailed during the forgot-password flow. Same
  // entropy as the setup token. Cleared the moment the user redeems it.
  passwordResetToken     String?   @unique
  // Expiry stamp for `passwordResetToken`. 1-hour TTL — tighter than the
  // setup token because the user already has an account and is actively
  // resetting; a shorter window limits exposure from a leaked token.
  passwordResetExpiresAt DateTime?
  // OTP-resend abuse tracking (POST /api/auth/resend-otp). otpResendCount
  // counts resends issued in the current window; when it reaches the cap
  // (MAX_OTP_RESENDS) the endpoint stamps otpLockoutUntil 1 hour out and
  // refuses further resends with 429 until then. Both are reset on a
  // successful OTP verification (full login). Distinct from OtpCode.attempts,
  // which tracks failed *verify* guesses against a single live code.
  otpResendCount  Int       @default(0)
  otpLockoutUntil DateTime?
  // Stamped every time the user changes their password. The auth middleware
  // rejects any JWT whose iat is before this timestamp, mathematically
  // revoking all tokens issued prior to the password change.
  passwordUpdatedAt DateTime  @default(now())
  // Opaque UUID embedded in every access JWT and kept here as the
  // single source of truth for the active session. A new login overwrites
  // this, instantly invalidating any previously issued tokens.
  activeSessionId   String?
  // Multi-role: a user can wear multiple hats simultaneously (e.g. an IT
  // Director who is also an Admin, or a Department Head who is also a
  // Manager and an Employee). Permissions are the UNION of the listed
  // roles; pages that need a single role (landing page, ID prefix) call
  // primaryRole() to pick the highest-privilege one.
  //
  // Postgres native enum array — same query ergonomics as a junction
  // table for the read patterns we have ("does user X have role Y?"),
  // without the extra table or join. Filter with `roles: { has: 'Admin' }`
  // in Prisma; equivalent to `'Admin' = ANY(roles)` in SQL.
  roles        UserRole[]
  team         String
  managerId    String?
  jobTitle     String

  // When true, this user is excluded from the automated scheduled
  // reminder emails (submission reminders for employees, pending-review
  // reminders for managers). Default false = everyone receives reminders
  // unless an admin explicitly opts them out from the Employee Management
  // view. Gate lives in src/lib/reminderScheduler.ts; in-app bell
  // notifications are unaffected.
  emailNotificationsExempt Boolean @default(false)

  manager    User?  @relation("Reports", fields: [managerId], references: [id])
  reports    User[] @relation("Reports")

  allocations        AllocationRecord[] @relation("EmployeeRecords")
  managedAllocations AllocationRecord[] @relation("ManagerRecords")
  // Peer Coverage: allocation records this user was the one to actually
  // approve / return (accountability). Distinct from managedAllocations —
  // the covering peer may differ from the record's assigned manager.
  actionedAllocations AllocationRecord[] @relation("ActionedRecords")
  journalEntries     JournalEntry[]
  auditLogs          AuditLog[]
  otpCodes           OtpCode[]
  refreshTokens      RefreshToken[]
  notifications      Notification[]

  // Peer Coverage tabs. `peerCoverageTabs` are the tabs THIS manager has
  // pinned (the peers they cover); `coveredByTabs` are tabs where this
  // manager is the peer someone else pinned. Both cascade on user delete.
  peerCoverageTabs PeerCoverageTab[] @relation("TabOwner")
  coveredByTabs    PeerCoverageTab[] @relation("TabPeer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([managerId])
  // Note: no btree index on `roles` — Postgres can't btree array columns.
  // Filter-by-role at this scale (≤ thousands of users) is a fast scan;
  // add a GIN index later if the user table grows past tens of thousands.
}

model AllocationRecord {
  // Frontend ids: "ALC-2026-1020". Preserved as-is on import; auto-generated
  // on new records using the same pattern.
  id         String           @id
  employeeId String
  team       String
  managerId  String?
  month      String           // "January" … "December"
  year       String           // "2026"
  monthIndex Int              // 0–11
  status     AllocationStatus @default(Draft)

  submittedAt DateTime?
  reviewedAt  DateTime?
  feedback    String?

  // Denormalised audit stamp for manager-side edits (mirrors lastEditedBy in
  // the frontend). Separate from AuditLog — this is the "last editor" shown
  // in the review UI; AuditLog captures the full history.
  lastEditedByUserId   String?
  lastEditedByUserName String?
  lastEditedAt         DateTime?

  // Peer Coverage accountability. Stamped whenever this record is approved
  // or returned-for-revision with the id of the user who ACTUALLY clicked
  // the action — which, under peer coverage, may be a covering peer rather
  // than the record's assigned `managerId`. `actionedByName` is denormalised
  // for display (same rationale as lastEditedByUserName); the FK is kept for
  // referential integrity and SetNull-on-delete so history survives.
  actionedById   String?
  actionedByName String?
  actionedAt     DateTime?

  employee   User  @relation("EmployeeRecords", fields: [employeeId], references: [id])
  manager    User? @relation("ManagerRecords", fields: [managerId], references: [id])
  actionedBy User? @relation("ActionedRecords", fields: [actionedById], references: [id], onDelete: SetNull)

  activities AllocationActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, month, year])
  @@index([managerId])
  @@index([actionedById])
  @@index([status])
  @@index([year, monthIndex])
  // Composite: employee/manager scoped list() queries ordered by period.
  @@index([employeeId, year, monthIndex])
  // Composite: admin/finance queries filtering by status with period ordering.
  @@index([status, year, monthIndex])
}

model AllocationActivity {
  // UUID preserved from frontend (crypto.randomUUID()) so flag lookups by
  // activityId remain stable across import → API round-trips.
  id             String  @id @default(uuid())
  recordId       String
  streamCategory String  // "IT", "Projects", "General Work" …
  subCategory    String? // "Geniisys", "Quick Policy" — null for non-Project streams
  workType       String
  client         String
  description    String
  percentage     Float

  // Structured tag for "Specific Enhancement" work ("MTC API", "Smart Claims"
  // ...). Nullable on purpose: it is meaningless for every other work type,
  // and every row written before this column existed is legitimately null —
  // the Finance export falls back to parsing `description` for those.
  //
  // A String rather than an enum: the option list is business data Finance
  // will extend, and an enum would force a migration per addition. Validity is
  // enforced at the form + shared-schema layer, same as `client`/`workType`.
  enhancementTag String?

  // Position of the parent stream and this activity within it. Needed to
  // reconstruct the ordered WorkStreamData[] on read without relying on
  // insertion order.
  streamOrder   Int
  activityOrder Int

  // Flag fields mirror AllocationRecord.flags (Record<activityId, ActivityFlag>).
  // Storing inline avoids a join on every record read.
  flagReason String?
  flaggedAt  DateTime?

  record AllocationRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prisma does NOT auto-create indexes on FKs in Postgres.
  @@index([recordId])
}

// Peer Coverage tabs. Persists the peer-manager tabs a manager has pinned
// onto their Team Hub "Team Submissions" view so they survive across
// sessions/devices. A row means: `managerId` (the owner) is covering the
// team of `peerManagerId` (the peer). Business rule — both must belong to
// the same Team; enforced at the controller on insert, not in the schema
// (Team is a free-string on User, and the pair is validated live so a later
// team move doesn't strand a dangling row: stale-team tabs are filtered out
// on read).
model PeerCoverageTab {
  id            String   @id @default(uuid())
  managerId     String
  peerManagerId String
  createdAt     DateTime @default(now())

  manager User @relation("TabOwner", fields: [managerId], references: [id], onDelete: Cascade)
  peer    User @relation("TabPeer", fields: [peerManagerId], references: [id], onDelete: Cascade)

  // One tab per (owner, peer) pair — adding an existing peer is idempotent.
  @@unique([managerId, peerManagerId])
  @@index([managerId])
}

model JournalEntry {
  id         String  @id @default(uuid())
  employeeId String
  date       String  // "YYYY-MM-DD" — kept as string to match localStorage key
  content    String
  // Parsed TimeBlock[] cached from the last aggregation run. Nullable because
  // raw-text entries are valid without blocks; blocks are populated lazily by
  // the AI aggregation endpoint.
  blocks     Json?

  // Cascade so admin user-deletes don't fail on existing journal rows.
  employee User @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId, date])
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  // SHA-256 hash of the raw token. We never store the raw token; lookups are
  // constant-time on the unique index. SHA-256 (not bcrypt) because the
  // tokens are 512 bits of random — bcrypt's slowness is wasted on
  // high-entropy inputs.
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  // When this token is rotated, its successor is linked here. Useful for
  // tracing a session lineage during an incident investigation.
  replacedById String?
  // Captured at issue time so admins can recognize the device a session
  // belongs to (e.g. "log out my old phone").
  userAgent    String?
  ip           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  userId    String
  codeHash  String   // bcrypt hash of the 6-digit one-time code
  expiresAt DateTime
  used      Boolean  @default(false)
  // Failed-verify counter. Hard lockout (mark used) after MAX_OTP_ATTEMPTS so
  // a brute-forcer can't keep guessing the same live code.
  attempts  Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, used, expiresAt])
}

model AuditLog {
  id       Int     @id @default(autoincrement())
  userId   String? // null for system-generated events
  action   String  // "create" | "update" | "delete" | "approve" | "return" …
  entity   String  // "AllocationRecord" | "User" | "JournalEntry" …
  entityId String
  payload  Json?   // before/after snapshot or diff

  // SetNull preserves the audit row when the actor is deleted — never lose history.
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// In-app notification (the bell UI). Server-owned: created by workflow
// events (submit / approve / return), manual reminders, and the team-
// completion hook — plus self-targeted reminders posted by the client
// scheduler. Replaces the former localStorage-only store so notifications
// survive devices and reach the user that an event actually concerns.
model Notification {
  id           String           @id @default(uuid())
  targetUserId String
  title        String
  message      String
  type         NotificationType @default(info)
  isRead       Boolean          @default(false)
  // Optional in-app deep link (e.g. "/team-hub", "/allocations").
  actionUrl    String?

  // Cascade: a user's notifications are theirs alone — drop them with the user.
  target User @relation(fields: [targetUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Primary read pattern: "this user's notifications, newest first."
  @@index([targetUserId, createdAt])
  // Unread-count badge query.
  @@index([targetUserId, isRead])
}

// ── Taxonomy / config ────────────────────────────────────────────────────────
// These mirror the ClientsConfigContext's admin-editable lists.
// Stored normalised so renames are a single UPDATE and CRUD is straightforward.

model Team {
  id        Int    @id @default(autoincrement())
  name      String @unique
  sortOrder Int    @default(0)
}

model Client {
  id        Int    @id @default(autoincrement())
  name      String @unique
  sortOrder Int    @default(0)
}

// Enhancement tag roster for "Specific Enhancement" work. Deliberately the
// same flat shape as Client — a maintained lookup list with no relations. The
// name is the value denormalised onto AllocationActivity.enhancementTag, so
// renames MUST cascade there (see settings.ts::renameEnhancement) or history
// falls out of its Finance bucket, the ghost-category bug all over again.
model Enhancement {
  id        Int    @id @default(autoincrement())
  name      String @unique
  sortOrder Int    @default(0)
}

model MainCategory {
  id        Int    @id @default(autoincrement())
  name      String @unique
  sortOrder Int    @default(0)

  // Client names associated with this main category. Populated only when the
  // category has NO sub-categories — i.e. a flattened project such as
  // "Geniisys", promoted out of the old "Projects" tier. Mirrors
  // SubCategory.clients exactly (PostgreSQL text[]) so the parser's client
  // fan-out map can be keyed on either tier without a shape change.
  clients   String[]

  subCategories SubCategory[]
  // Rules that hang directly off this main category (no sub-category hop).
  // Before flattening, the only cascade path was
  //   MainCategory -> SubCategory (Cascade) -> InferenceRule (Cascade)
  // which leaves rules for a sub-less category with no FK anchor at all.
  // This relation restores DB-level cleanup for that case.
  inferenceRules InferenceRule[]
}

model SubCategory {
  id               Int    @id @default(autoincrement())
  name             String @unique
  mainCategoryId   Int
  // Client names associated with this sub-category (Projects taxonomy).
  // String[] maps to a PostgreSQL text[] column — no join table needed for
  // this simple ordered list.
  clients          String[]
  sortOrder        Int    @default(0)

  mainCategory   MainCategory  @relation(fields: [mainCategoryId], references: [id], onDelete: Cascade)
  inferenceRules InferenceRule[]

  @@index([mainCategoryId])
}

model WorkType {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  // Names of main categories or sub categories this work type applies to.
  // Many-to-many via String[] avoids a polymorphic junction table; the names
  // are enforced at the application layer (same as the frontend).
  parents  String[]

  inferenceRules InferenceRule[]
}

model InferenceRule {
  id          Int      @id @default(autoincrement())
  keywords    String[] // case-insensitive substrings scored against journal text
  category    String
  subCategory String?
  workType    String
  sortOrder   Int      @default(0)

  // Optional FK columns added for DB-level cascade delete. Nullable so all
  // pre-migration rules remain valid; newly auto-generated rules populate both.
  // Chain: MainCategory → SubCategory (Cascade) → InferenceRule (Cascade)
  // so deleting a MainCategory wipes its InferenceRules two hops down.
  //
  // `mainCategoryId` is the one-hop variant for categories with no
  // sub-category tier (flattened projects). A post-flatten rule should carry
  // exactly ONE of mainCategoryId / subCategoryId — whichever tier it
  // actually belongs to — never both.
  mainCategoryId Int?
  subCategoryId  Int?
  workTypeId     Int?

  mainCategoryRef MainCategory? @relation(fields: [mainCategoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subCategoryRef  SubCategory?  @relation(fields: [subCategoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  workTypeRef     WorkType?     @relation(fields: [workTypeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([mainCategoryId])
  @@index([subCategoryId])
  @@index([workTypeId])
}

// ── Operations ───────────────────────────────────────────────────────────────

// Maintenance mode. SINGLETON: exactly one row, always id = 1 — seeded by the
// migration so GET /api/maintenance is a plain findUnique that can never miss.
// Admins flip `enabled` from Settings → Maintenance; every client polls the
// public GET and swaps the whole app for the announcement page when it's on.
//
// Deliberately NOT an env var: flipping it must not require a rebuild + PM2
// reload, which is exactly the thing you can't do mid-incident.
model MaintenanceSetting {
  id      Int     @id @default(1)
  enabled Boolean @default(false)

  // Copy rendered on the announcement page. Stored (not hardcoded) so the
  // message can name the actual window and work being done.
  title   String @default("Scheduled Maintenance")
  message String @default("The CPI Work Allocation app is temporarily unavailable while we perform scheduled maintenance. Please check back shortly.")

  // Optional window. `endsAt` drives the "Expected back by" line; both are
  // null when the maintenance is open-ended.
  startsAt DateTime?
  endsAt   DateTime?

  // Who last flipped it. Denormalised to a plain id + name rather than an FK:
  // this is a display stamp on the settings panel, and it should survive the
  // admin's account being deleted. The authoritative trail is AuditLog
  // (action: 'maintenance-update', entity: 'MaintenanceSetting').
  updatedById   String?
  updatedByName String?
  updatedAt     DateTime @updatedAt
}
