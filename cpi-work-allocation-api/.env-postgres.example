# Postgres container env — used ONLY by docker-compose.prod.yml via --env-file.
# Copy to `.env-postgres`, set a strong password, and chmod 600.
#
#   openssl rand -hex 24
#
# This password must MATCH the password embedded in DATABASE_URL inside the
# API's `.env` file (cpi-work-allocation-api/.env).

POSTGRES_PASSWORD=REPLACE_WITH_openssl_rand_hex_24
